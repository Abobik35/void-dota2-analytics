OPENDOTA_BASE_URL=https://api.opendota.com/api
# Необязательно: ключ OpenDota повышает лимиты запросов
OPENDOTA_API_KEY=
DATABASE_URL=sqlite:///./void.db
CORS_ORIGINS=http://localhost:5173
# Адрес сайта в браузере; нужен для входа через Steam
PUBLIC_URL=http://localhost:5173
# Секрет для подписи сессий. Если пусто, создаётся файл .secret_key
SECRET_KEY=
# Папка собранного фронтенда (npm run build из frontend/). Задаётся только при публикации одним сервером
FRONTEND_DIST=
